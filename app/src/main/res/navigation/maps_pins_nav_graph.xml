<navigation
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/maps_pins_nav_graph"
  app:startDestination="@id/map_fragment">

  <action
    android:id="@+id/edit_pin"
    app:destination="@id/edit_fragment">

    <argument
      android:name="pin_id"
      app:argType="long"
      android:defaultValue="0L"/>

  </action>

  <fragment
    android:id="@+id/map_fragment"
    android:name="edu.cnm.deepdive.trailtrack.controller.MapFragment"
    android:label="@string/map_fragment_title"
    tools:layout="@layout/fragment_map"/>

 <fragment
   android:id="@+id/pins_fragment"
   android:name="edu.cnm.deepdive.trailtrack.controller.PinsFragment"
   android:label="@string/pins_fragment_title"
   tools:layout="@layout/fragment_pins"/>

  <dialog
    android:id="@+id/edit_fragment"
    android:name="edu.cnm.deepdive.trailtrack.controller.EditFragment"
    tools:layout="@layout/fragment_edit">

    <argument
      android:name="pin_id"
      app:argType="long"
      android:defaultValue="0L"/>

  </dialog>



</navigation>

